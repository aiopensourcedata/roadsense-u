include CITATION.cff README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md LICENSE NOTICE THIRD_PARTY_NOTICES.md
include Dockerfile docker-compose.yml .gitignore .dockerignore
recursive-include src *.py py.typed
recursive-include scripts *.py
recursive-include configs *.yaml *.yml *.json
recursive-include tests *.py *.json
recursive-include docs *.md
recursive-include .github *.yaml *.yml *.md
prune .venv
prune .git
prune .aws
prune .agents
prune .codex
prune data
prune outputs
global-exclude *.py[cod] *.pt *.onnx *.joblib *.db *.pem *.key
global-exclude .env .env.*
include .env.example data/.gitkeep outputs/.gitkeep

include .streamlit/config.toml

# Reviewed synthetic-only browser captures; do not include arbitrary image/footage directories.
include docs/assets/overview.png docs/assets/event-evidence.png docs/assets/location-analytics.png
include docs/assets/evaluation.png docs/assets/live-preview.png
recursive-include docs/assets *.json
