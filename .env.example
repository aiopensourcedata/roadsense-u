# Generate your own values. Compose refuses empty credentials.
ROADSENSE_API_KEY=
POSTGRES_PASSWORD=
ROADSENSE_DATABASE_URL=postgresql+psycopg://roadsense:CHANGE_ME@localhost:5432/roadsense
ROADSENSE_API_URL=http://127.0.0.1:8000
ROADSENSE_RETENTION_DAYS=30
ROADSENSE_MAX_REQUEST_BYTES=65536
# Development shared key is explicit; the enterprise lab uses generated scoped files.
ROADSENSE_AUTH_MODE=development_shared_key
ROADSENSE_SERVICE_CREDENTIALS=[]
ROADSENSE_AUTO_MIGRATE=true
ROADSENSE_RETENTION_INTERVAL_S=3600
# Optional trusted local/private CA certificate path; TLS verification stays enabled.
# ROADSENSE_API_CA_FILE=outputs/cloud-enterprise/tls/root.crt
